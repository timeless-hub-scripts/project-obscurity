# Required Discord application settings
DISCORD_TOKEN=put_your_bot_token_here
CLIENT_ID=put_your_discord_application_id_here
# Optional: register commands to one server for instant testing
GUILD_ID=
# Optional: set one or more comma-separated Discord user IDs for OBSCURITY staff
OWNER_IDS=
# Optional: use a persistent Railway volume mounted at /data
DATA_DIR=./data
